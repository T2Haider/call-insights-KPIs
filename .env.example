# Copy to .env and adjust. Every setting is optional in development; defaults are shown.
# Validated at startup in src/lib/config.ts.

NODE_ENV=development
LOG_LEVEL=info                      # debug | info | warn | error

# SQLite file. Relative paths resolve from the project root.
DATABASE_URL=./data/app.db

# --- Webhook: how calls arrive (see docs/WEBHOOK_SPEC.md) ---
# Shared secret the call sender puts in "Authorization: Bearer <secret>".
# REQUIRED in production (the built-in dev default is refused). Min 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=dev-only-webhook-secret
WEBHOOK_MAX_BODY_BYTES=5242880      # reject larger bodies with 413 (default 5 MB; long transcripts fit easily)

# If the sender's call_recording_path is an object path (not a full URL), the link is
# built as RECORDING_BASE_URL + path. Leave unset if the sender always sends full URLs.
# RECORDING_BASE_URL=https://minio.example.com/recordings/

# Region used to parse phone numbers that arrive without a "+" country prefix.
DEFAULT_PHONE_REGION=US

# --- Background worker (retention + stuck-call check; there is nothing to poll) ---
# A call still missing its recording or transcript after this long is marked "failed".
# Calls are expected to arrive complete, so this is only a safety net.
PROCESSING_TIMEOUT_MINUTES=120
WORKER_INTERVAL_SECONDS=60          # how often the stuck-call check runs

# --- Data retention ---
# Calls older than this many days are deleted from THIS dashboard's database
# (call details, transcript, stored recording link). Recording files in MinIO
# are never touched. Runs in the worker process at startup and then daily.
# Set to 0 to disable cleanup.
RETENTION_DAYS=30

# --- Worker -> web server channel (live updates for stuck-call changes) ---
# REQUIRED in production (the built-in dev default is refused). Min 8 characters.
APP_URL=http://localhost:3000
INTERNAL_EVENTS_SECRET=dev-only-internal-secret

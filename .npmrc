# Install without running dependency lifecycle scripts.
# better-sqlite3 ships prebuilt binaries, but when installing from package-lock.json npm adds an implicit
# `node-gyp rebuild` for it, which fails on any machine without a C++ build toolchain (e.g. Windows without
# Visual Studio). Nothing in this project needs install scripts (the others only verify prebuilt binaries).
# If you add a package that needs a build step, run `npm rebuild <package>`.
ignore-scripts=true
